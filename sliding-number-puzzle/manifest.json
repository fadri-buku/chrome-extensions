{
  "manifest_version": 3,
  "name": "Sliding Number Puzzle",
  "version": "1.0.0",
  "description": "Classic 15-puzzle (sliding number tiles) you can play from the toolbar popup.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Sliding Number Puzzle"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"]
}
